{
  "name": "enrique-dash",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/*.test.js",
    "levels:play": "node tools/auto-player.mjs",
    "levels:compose": "node tools/compose-levels.mjs && node tools/apply-feature-quotas.mjs",
    "levels:compose:wool": "node tools/compose-levels.mjs --campaign wool && node tools/apply-feature-quotas.mjs --campaign wool",
    "levels:report": "node tools/level-report.mjs",
    "levels:check": "node tools/auto-player.mjs && node --test src/levels.tools.test.js"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.7"
  }
}
